{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fetch-natural-earth": "tsx scripts/fetch-natural-earth.ts",
    "build-maps": "tsx scripts/build-maps/index.ts && tsx scripts/build-maps/world.ts",
    "build-atlas": "tsx scripts/etl/build.ts",
    "calibrate": "tsx scripts/etl/calibrate.ts",
    "gaps": "tsx scripts/etl/gaps.ts",
    "route-coverage": "tsx scripts/etl/route-coverage.ts",
    "rule-coverage": "tsx scripts/etl/rule-coverage.ts",
    "quote-probe": "tsx scripts/etl/quote-probe.ts",
    "transport-gaps": "tsx scripts/etl/transport-gaps.ts",
    "sync-content": "tsx scripts/etl/sync-content.ts",
    "prebuild": "npm run build-maps && npm run build-atlas && npm run build-package-cards",
    "build-package-cards": "tsx scripts/build-package-cards.ts",
    "prepare-media": "tsx scripts/prepare-media.ts",
    "lighthouse": "npm run build-maps && npm run build && lhci autorun",
    "cf:typecheck": "tsc --noEmit",
    "cf:dev": "wrangler dev --env=\"\" -c wrangler.toml -c workers/api/wrangler.toml --persist-to .wrangler/state",
    "cf:dev:api": "wrangler dev --env=\"\" -c workers/api/wrangler.toml --persist-to .wrangler/state",
    "cf:d1:migrate": "wrangler d1 migrations apply atlas --remote --env=\"\" --config workers/api/wrangler.toml",
    "cf:d1:migrate:local": "wrangler d1 migrations apply atlas --local --env=\"\" --persist-to .wrangler/state --config workers/api/wrangler.toml",
    "cf:d1:query": "wrangler d1 execute atlas --local --env=\"\" --persist-to .wrangler/state --config workers/api/wrangler.toml",
    "cf:check": "wrangler deploy --dry-run --env=\"\" -c workers/api/wrangler.toml && wrangler deploy --dry-run --env=\"\"",
    "cf:deploy:api": "wrangler deploy --env=\"\" --config workers/api/wrangler.toml",
    "cf:deploy:web": "wrangler deploy --env=\"\"",
    "cf:deploy": "npm run cf:deploy:api && npm run cf:deploy:web"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.5",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "mapshaper": "^0.7.51",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true,
    "unrs-resolver@1.12.2": true
  }
}
